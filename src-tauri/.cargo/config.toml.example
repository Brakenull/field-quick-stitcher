# Reference for .cargo/config.toml (gitignored, machine-specific; cargo doesn't read this
# .example name). You normally don't write config.toml by hand: setup.ps1 at the repo root
# generates it from a Visual Studio developer shell. This file documents what it writes.
#
# Every entry is `force = true`: cargo's [env] otherwise leaves an already-set variable
# alone, and a "Developer PowerShell for VS" sets VCPKG_ROOT to Visual Studio's own vcpkg.

[env]
# The folder setup.ps1 installs vcpkg.json's libraries into (<repo>\vcpkg_env), NOT
# Visual Studio's vcpkg folder. The Rust vcpkg crate (0.2.x, used by the opencv crate)
# only reads a classic vcpkg layout: <VCPKG_ROOT>\.vcpkg-root plus
# <VCPKG_ROOT>\installed\<triplet>\ and <VCPKG_ROOT>\installed\vcpkg\status. It doesn't
# understand manifest mode's vcpkg_installed\ folder, so setup.ps1 runs
# `vcpkg install --x-install-root=vcpkg_env\installed` and creates the .vcpkg-root marker.
# build.rs also reads it, to copy <VCPKG_ROOT>\installed\x64-windows\bin\*.dll next to the exe.
VCPKG_ROOT = { value = '<repo>\vcpkg_env', force = true }

# Link OpenCV as DLLs (the x64-windows triplet), which build.rs copies and the MSI bundles.
VCPKGRS_DYNAMIC = { value = '1', force = true }

# opencv-rust's build script checks the generic OPENCV_PACKAGE_NAME env var first for every
# probe method. A machine-wide value left over from an unrelated CMake project (e.g.
# `OpenCV`) silently breaks the vcpkg probe, since vcpkg installs the port as `opencv4`.
OPENCV_PACKAGE_NAME = { value = 'opencv4', force = true }

# Only the vcpkg probe (plus the explicit OPENCV_INCLUDE_PATHS/OPENCV_LINK_* "environment"
# probe) runs, so a CMake or pkg-config OpenCV elsewhere on the machine is never picked up.
OPENCV_DISABLE_PROBES = { value = 'pkg_config,cmake,vcpkg_cmake', force = true }

# libclang for opencv's binding generator (via clang-sys). setup.ps1 prefers Visual Studio's
# "C++ Clang Compiler for Windows" component (<VS>\VC\Tools\Llvm\x64\bin), then
# C:\Program Files\LLVM\bin. cargo's [env] can't change PATH, so clang-sys gets clang.exe
# through CLANG_PATH directly.
LIBCLANG_PATH = { value = '<folder with libclang.dll>', force = true }
CLANG_PATH = { value = '<that folder>\clang.exe', force = true }

# The MSVC STL + Windows SDK headers/libs a developer shell sets up (vcvars64.bat), baked in
# so `cargo build` / `npm run tauri dev` work from a plain shell. Copied from $env:INCLUDE
# and $env:LIB of the developer shell setup.ps1 opens; rerun setup.ps1 after a Visual Studio
# or Windows SDK update changes these versioned paths.
INCLUDE = { value = '<$env:INCLUDE from a VS developer shell>', force = true }
LIB = { value = '<$env:LIB from a VS developer shell>', force = true }
