# Template for .cargo/config.toml (gitignored - machine-specific, not read by cargo
# under this .example name). Copy to config.toml and fill in the placeholders for
# opencv (Phase 2, Quick Stitch) to build without manually sourcing vcvars.
#
# GDAL was dropped per quick-stitch.md section 3 (replaced by the pure-Rust
# `tiff` crate for GeoTIFF I/O), so only opencv's native toolchain is needed now.
#
# To regenerate INCLUDE/LIB: open "Developer PowerShell for VS", run
#   echo $env:INCLUDE
#   echo $env:LIB
# and paste the results below (semicolon-separated, single-quoted).

[env]
VCPKG_ROOT = '<path to your vcpkg checkout, e.g. C:\vcpkg>'
VCPKGRS_DYNAMIC = "1"
LIBCLANG_PATH = '<path to LLVM bin, e.g. C:\Program Files\LLVM\bin>'

# opencv-rust's build script checks the generic OPENCV_PACKAGE_NAME env var FIRST for
# every probe method (pkg-config, cmake, AND vcpkg) - it shadows the more specific
# OPENCV_PKGCONFIG_NAME/OPENCV_CMAKE_NAME/OPENCV_VCPKG_NAME vars whenever set. Don't
# set OPENCV_PACKAGE_NAME globally on your machine (even for an unrelated cmake
# project) - it will silently break the vcpkg probe here, since vcpkg installs the
# port as `opencv4` (confirm with `vcpkg list`), not `OpenCV`. Instead set, as
# machine-wide User/System env vars (outside this file):
#   OPENCV_VCPKG_NAME=opencv4
# and leave OPENCV_PACKAGE_NAME unset so cmake probing (package name "OpenCV") still
# works too, should you ever get cmake/ninja installed.

# clang (opencv's binding generator) needs the MSVC STL + Windows SDK headers/libs
# that a "Developer Command Prompt" would normally set up via vcvars64.bat. Baked
# in here so `cargo build`/`npm run tauri dev` work from a plain shell.
INCLUDE = { value = '<paste $env:INCLUDE from a VS dev shell>', force = true }
LIB = { value = '<paste $env:LIB from a VS dev shell>', force = true }

# cargo's [env] cannot override PATH (confirmed empirically - force=true has no
# effect on PATH specifically, cargo always keeps its own). So instead of trying
# to get clang.exe onto PATH, point clang-sys straight at the binary - it reads
# CLANG_PATH directly, bypassing PATH search entirely.
CLANG_PATH = '<path to clang.exe, e.g. C:\Program Files\LLVM\bin\clang.exe>'

# vcpkg's installed\x64-windows\bin carries the opencv DLLs (and their
# transitive deps) needed at runtime. Since PATH can't be set here, add that
# directory to your own Windows user PATH once (a normal one-time machine
# setup step) so `cargo run`/`tauri dev` can load them.
